# Copy to .env and fill in. .env is gitignored; this file is committed so a
# reader knows which secrets the project needs without ever seeing yours.

# Generator LLM — writes the answers.
GEMINI_API_KEY=

# Judge LLM — grades answers during evaluation. Kept as a separate variable
# even when it holds the same key, so the judge can be swapped independently of
# the generator. Scoring a model's output with the same model biases the result.
JUDGE_API_KEY=
